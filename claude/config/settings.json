{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(tmux:*)",
      "Bash(podman:*)",
      "Bash(uv:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(cd:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(rm -f:*)",
      "Bash(rm -rf /Users/*/wc/*)",
      "Bash(ln:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(diff:*)",
      "Bash(python*)",
      "Bash(pip:*)",
      "Bash(cargo:*)",
      "Bash(brew:*)",
      "Bash(make:*)",
      "Bash(sleep:*)",
      "Bash(* --version)",
      "Bash(npm *)",
      "Bash(*-h*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(pandoc:*)"
    ],
    "deny": [
      "Bash(curl|*sh:*)",
      "Bash(wget|*sh:*)",
      "Bash(*>/dev/tcp/*)",
      "Bash(*base64*decode*)",
      "Bash(chmod 777:*)",
      "Bash(sudo:*)",
      "Bash(nc -:*)",
      "Bash(crontab:*)",
      "Bash(*LaunchAgents*)",
      "Bash(*LaunchDaemons*)",
      "Edit(~/.ssh/*)",
      "Edit(~/.aws/*)",
      "Edit(~/.config/secrets)",
      "Edit(/etc/*)",
      "Edit(~/.crontab)",
      "Bash(*aws/credentials*)",
      "Bash(*aws/sso/cache*)",
      "Bash(*/.ssh/*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*gh/hosts.yml*)",
      "Bash(*docker/config.json*)",
      "Bash(*/.netrc*)",
      "Bash(security dump-keychain:*)",
      "Bash(security find-generic-password:*)",
      "Bash(*curl*-d*)",
      "Bash(*curl*--data*)",
      "Bash(*curl*-T*)",
      "Bash(*curl*@*)",
      "Bash(*wget*--post*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(printenv:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "skillOverrides": {
    "assurance-criteria": "off",
    "feature-model": "off",
    "git-worktree-workflow": "off",
    "package-handling": "off",
    "project-structure": "off",
    "testing-strategy": "off",
    "shell-help-display": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {},
  "effortLevel": "low",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "teammateMode": "tmux",
  "skipAutoPermissionPrompt": true,
  "additionalDirectories": [
    ".",
    "~/.local/state/agent-context",
    "~/.dotfiles",
    "~/wc/**",
    "/workspace/**"
  ],
  "tui": "fullscreen"
}
