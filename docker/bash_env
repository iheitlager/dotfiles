# Docker XDG compliant
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"

# Lima XDG compliant (default ~/.lima); this only affects limactl directly.
export LIMA_HOME="$XDG_DATA_HOME/lima"

# Colima XDG compliant - VM disks are data, not config. Colima's Lima home
# lives under $COLIMA_HOME/_lima.
export COLIMA_HOME="$XDG_DATA_HOME/colima"

# podman-compose builds services in parallel by default, interleaving
# per-step build output from multiple services into an unreadable mess.
export COMPOSE_PARALLEL_LIMIT=1

# Point the Docker CLI at whichever runtime is active.
# Podman is primary; Colima (COLIMA_HOME-based socket) is a supported fallback.
_docker_host_socket() {
    local podman_socket
    if command -v podman >/dev/null 2>&1; then
        podman_socket=$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null)
        if [ -n "$podman_socket" ] && [ -S "$podman_socket" ]; then
            echo "$podman_socket"
            return
        fi
    fi
    echo "$XDG_DATA_HOME/colima/default/docker.sock"
}
export DOCKER_HOST="unix://$(_docker_host_socket)"
