#!/usr/bin/env bash
# ctop wrapper: auto-detects podman or colima and sets DOCKER_HOST accordingly.
# Also fixes the termbox crash in tmux by normalizing TERM.

RED='\033[0;31m'
NC='\033[0m'

# Fix termbox crash: force a terminfo type that ctop's termbox supports
export TERM=xterm-256color

# Locate the real ctop binary (Apple Silicon vs Intel brew prefixes).
# Hardcoded candidates, not `command -v`, so this doesn't recurse into itself
# when local/bin is earlier on PATH than the brew-installed binary.
CTOP_BIN=""
for candidate in /opt/homebrew/bin/ctop /usr/local/bin/ctop; do
    if [ -x "$candidate" ]; then
        CTOP_BIN="$candidate"
        break
    fi
done
if [ -z "$CTOP_BIN" ]; then
    printf "${RED}ctop binary not found in /opt/homebrew/bin or /usr/local/bin.${NC}\n"
    exit 1
fi

# Check podman machine
if podman machine list --format '{{.Running}}' 2>/dev/null | grep -q true; then
    socket=$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null | head -1)
    if [ -n "$socket" ]; then
        export DOCKER_HOST="unix://${socket}"
    fi
    exec "$CTOP_BIN" "$@"
fi

# Check colima
if colima status &>/dev/null; then
    # Parse socket path from colima status output, fall back to default
    socket=$(colima status 2>/dev/null | awk '/docker socket:/ { print $NF }')
    export DOCKER_HOST="${socket:-unix://${HOME}/.config/colima/default/docker.sock}"
    exec "$CTOP_BIN" "$@"
fi

printf "${RED}No container runtime detected. Start podman or colima first.${NC}\n"
exit 1
